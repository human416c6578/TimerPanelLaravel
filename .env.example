# Environment for `docker compose`. Copy to .env and fill in.
# The Laravel application reads these as real environment variables, so no
# .env file is needed inside the container.

APP_NAME="Timer Panel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

# Game database (external, read-only from this app's point of view).
# A database running on your own machine is host.docker.internal, not localhost.
GAME_DB_HOST=host.docker.internal
GAME_DB_PORT=3306
GAME_DB_DATABASE=game_db
GAME_DB_USERNAME=game_user
GAME_DB_PASSWORD=

# Directory on the host holding the .rec recordings, mounted at /srv/replays.
REPLAY_HOST_PATH=./docker/replays
REPLAY_DOWNLOAD_URL=https://cs-gfx.eu/uploads/recording
FASTDL_BHOP_URL=http://fastdl.cs-gfx.eu/7c1cc7a5-03d1-4475-93d5-abab1847c0f2/cstrike/
FASTDL_DEATHRUN_URL=http://fastdl.cs-gfx.eu/0d3d0661-5f4e-45c2-acbc-000eeeccb067/cstrike/

# Map pictures: URL templates with {map}, comma-separated. Empty keeps the generated covers.
MAP_IMAGE_SOURCES=https://image.gametracker.com/images/maps/160x120/cs/{map}.jpg,https://banners.gametracker.rs/map/cs/{map}.jpg,https://image.gametracker.com/images/maps/160x120/css/{map}.jpg,https://image.gametracker.com/images/maps/160x120/csgo/{map}.jpg
STEAM_API_KEY=

MAIL_MAILER=log
TELESCOPE_ENABLED=false

# Dev profile only.
MAILPIT_UI_PORT=8025
VITE_PORT=5173
